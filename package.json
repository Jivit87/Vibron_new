{
  "name": "viberon",
  "version": "0.1.0",
  "description": "Viberon desktop workspace with editor, graph, and chat",
  "author": "Viberon",
  "private": true,
  "main": "electron/main.js",
  "bin": {
    "viberon": "bin/viberon"
  },
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "node scripts/dev-desktop.js",
    "build": "next build",
    "build:desktop": "pnpm build && electron-builder",
    "start": "next start",
    "start:desktop": "electron .",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "viberon": "tsx cli/main.ts",
    "eval": "tsx cli/main.ts eval"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@monaco-editor/react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^13.10.0",
    "gpt-tokenizer": "^3.4.0",
    "groq-sdk": "^1.2.0",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "shadcn": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tar": "^7.5.15",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "fast-check": "^4.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.viberon.app",
    "productName": "Viberon",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "bin": {
    "viberon": "bin/viberon"
  }
}
