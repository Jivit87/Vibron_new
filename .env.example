# Evaluation supplies the model credential at runtime as AI_API_KEY — do not
# put a real key in this file or commit one anywhere. See docs/HACKATHON_BRIEF.md
# and lib/ai/provider-config.ts for how the key's prefix selects the provider.

AI_API_KEY=
# Optional overrides, only needed for a non-default endpoint/model:
AI_BASE_URL=
AI_MODEL=
AI_PROVIDER=
